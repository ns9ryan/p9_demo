syntax = "v1"

import "types/common.api"

type (
	// 货币信息
	CurrencyInfo {
		// 货币ID
		Id int64 `json:"id"`
		// 货币编码
		Code string `json:"code"`
		// 名称翻译Key
		NameKey string `json:"name_key"`
		// 当前语言名称, 开发阶段用于调试
		Name string `json:"name"`
		// 货币类型: 1法定货币, 2虚拟货币
		CurrencyType int64 `json:"currency_type"`
		// 货币符号
		Symbol string `json:"symbol"`
		// 金额换算倍率, 如 USD=100, VND=1
		AmountFactor int64 `json:"amount_factor"`
		// 状态: 1启用, 2停用
		Status int64 `json:"status"`
		// 排序值, 数值越小越靠前
		SortNo int64 `json:"sort_no"`
	}
	// 修改货币请求
	UpdateCurrencyRequest {
		// 货币ID
		Id int64 `json:"id" validate:"required,gt=0"`
		// 货币符号
		Symbol *string `json:"symbol,optional" validate:"omitempty,max=16"`
		// 状态: 1启用, 2停用
		Status *int64 `json:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 修改货币响应
	UpdateCurrencyResponse  {}
	// 获取货币请求
	GetCurrencyRequest {
		// 货币ID
		Id int64 `form:"id" validate:"required,gt=0"`
	}
	// 获取货币响应
	GetCurrencyResponse {
		// 货币信息
		CurrencyInfo
	}
	// 获取货币管理列表请求
	ListCurrenciesRequest {
		// 分页参数
		PageRequest
		// 状态: 1启用, 2停用
		Status *int64 `form:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 获取货币管理列表响应
	ListCurrenciesResponse {
		// 数据总数
		Total int64 `json:"total"`
		// 货币列表
		List []CurrencyInfo `json:"list"`
	}
	// 获取全部货币请求
	ListAllCurrenciesRequest {
		// 状态: 1启用, 2停用
		Status *int64 `form:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 获取全部货币响应
	ListAllCurrenciesResponse {
		// 货币列表
		List []CurrencyInfo `json:"list"`
	}
	// 调整货币排序请求
	ReorderCurrencyRequest {
		// 需要移动的货币ID
		Id int64 `json:"id" validate:"required,gt=0"`
		// 目标货币ID
		TargetId int64 `json:"target_id" validate:"required,gt=0"`
	}
	// 调整货币排序响应
	ReorderCurrencyResponse  {}
)

@server (
	group:      currency
	prefix:     /admin/currency
	middleware: Jwt,ActionLog,Authority
)
service platform_base {
	// 修改货币
	@handler UpdateCurrency
	post /update (UpdateCurrencyRequest) returns (UpdateCurrencyResponse)

	// 获取货币
	@handler GetCurrency
	get /get (GetCurrencyRequest) returns (GetCurrencyResponse)

	// 获取货币管理列表
	@handler ListCurrencies
	get /list (ListCurrenciesRequest) returns (ListCurrenciesResponse)

	// 获取全部货币
	@handler ListAllCurrencies
	get /list-all (ListAllCurrenciesRequest) returns (ListAllCurrenciesResponse)

	// 调整货币排序
	@handler ReorderCurrency
	post /reorder (ReorderCurrencyRequest) returns (ReorderCurrencyResponse)
}

