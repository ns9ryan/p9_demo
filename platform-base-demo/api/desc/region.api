syntax = "v1"

import "types/common.api"

type (
	// 国家地区信息
	RegionInfo {
		// 国家或地区ID
		Id int64 `json:"id"`
		// 国家或地区编码
		Code string `json:"code"`
		// 国际电话区号, 不包含加号
		CallingCode string `json:"calling_code"`
		// 多语言名称
		NameI18n map[string]string `json:"name_i18n"`
		// 状态: 1启用, 2停用
		Status int64 `json:"status"`
		// 排序值, 数值越小越靠前
		SortNo int64 `json:"sort_no"`
	}
	// 创建国家地区请求
	CreateRegionRequest {
		// 国家或地区编码
		Code string `json:"code" validate:"required,len=2"`
		// 国际电话区号, 不包含加号
		CallingCode string `json:"calling_code" validate:"required,max=3"`
		// 多语言名称
		NameI18n map[string]string `json:"name_i18n" validate:"required"`
		// 状态: 1启用, 2停用
		Status *int64 `json:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 创建国家地区响应
	CreateRegionResponse {
		// 国家或地区ID
		Id int64 `json:"id"`
	}
	// 修改国家地区请求
	UpdateRegionRequest {
		// 国家或地区ID
		Id int64 `json:"id" validate:"required,gt=0"`
		// 国际电话区号, 不传时不修改
		CallingCode *string `json:"calling_code,optional" validate:"omitempty,max=3"`
		// 多语言名称, 为空时不修改
		NameI18n map[string]string `json:"name_i18n,optional"`
		// 状态: 1启用, 2停用
		Status *int64 `json:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 修改国家地区响应
	UpdateRegionResponse  {}
	// 获取国家地区请求
	GetRegionRequest {
		// 国家或地区ID
		Id int64 `form:"id" validate:"required,gt=0"`
	}
	// 获取国家地区响应
	GetRegionResponse {
		// 国家地区信息
		Region RegionInfo `json:"region"`
	}
	// 获取国家地区管理列表请求
	ListRegionsRequest {
		// 分页参数
		PageRequest
		// 状态: 1启用, 2停用
		Status *int64 `form:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 获取国家地区管理列表响应
	ListRegionsResponse {
		// 数据总数
		Total int64 `json:"total"`
		// 国家地区列表
		List []RegionInfo `json:"list"`
	}
	// 获取全部国家地区请求
	ListAllRegionsRequest {
		// 状态: 1启用, 2停用
		Status *int64 `form:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 获取全部国家地区响应
	ListAllRegionsResponse {
		// 国家地区列表
		List []RegionInfo `json:"list"`
	}
	// 调整国家地区排序请求
	ReorderRegionRequest {
		// 需要移动的国家地区ID
		Id int64 `json:"id" validate:"required,gt=0"`
		// 目标国家地区ID
		TargetId int64 `json:"target_id" validate:"required,gt=0"`
	}
	// 调整国家地区排序响应
	ReorderRegionResponse  {}
)

@server (
	group:  region
	prefix: /region
)
service platform_base {
	// 创建国家地区
	@handler CreateRegion
	post /create (CreateRegionRequest) returns (CreateRegionResponse)

	// 修改国家地区
	@handler UpdateRegion
	post /update (UpdateRegionRequest) returns (UpdateRegionResponse)

	// 获取国家地区
	@handler GetRegion
	get /get (GetRegionRequest) returns (GetRegionResponse)

	// 获取国家地区管理列表
	@handler ListRegions
	get /list (ListRegionsRequest) returns (ListRegionsResponse)

	// 获取全部国家地区
	@handler ListAllRegions
	get /list-all (ListAllRegionsRequest) returns (ListAllRegionsResponse)

	// 调整国家地区排序
	@handler ReorderRegion
	post /reorder (ReorderRegionRequest) returns (ReorderRegionResponse)
}

