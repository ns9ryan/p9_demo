syntax = "v1"

import "types/common.api"

type (
	// 时区信息
	TimezoneInfo {
		// 时区ID
		Id int64 `json:"id"`
		// IANA 时区编码
		Code string `json:"code"`
		// 多语言名称
		NameI18n map[string]string `json:"name_i18n"`
		// 状态: 1启用, 2停用
		Status int64 `json:"status"`
		// 排序值, 数值越小越靠前
		SortNo int64 `json:"sort_no"`
	}
	// 创建时区请求
	CreateTimezoneRequest {
		// IANA 时区编码
		Code string `json:"code" validate:"required,max=64"`
		// 多语言名称
		NameI18n map[string]string `json:"name_i18n" validate:"required"`
		// 状态: 1启用, 2停用
		Status *int64 `json:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 创建时区响应
	CreateTimezoneResponse {
		// 时区ID
		Id int64 `json:"id"`
	}
	// 修改时区请求
	UpdateTimezoneRequest {
		// 时区ID
		Id int64 `json:"id" validate:"required,gt=0"`
		// 多语言名称, 为空时不修改
		NameI18n map[string]string `json:"name_i18n,optional"`
		// 状态: 1启用, 2停用
		Status *int64 `json:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 修改时区响应
	UpdateTimezoneResponse  {}
	// 获取时区请求
	GetTimezoneRequest {
		// 时区ID
		Id int64 `form:"id" validate:"required,gt=0"`
	}
	// 获取时区响应
	GetTimezoneResponse {
		// 时区信息
		Timezone TimezoneInfo `json:"timezone"`
	}
	// 获取时区管理列表请求
	ListTimezonesRequest {
		// 分页参数
		PageRequest
		// 状态: 1启用, 2停用
		Status *int64 `form:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 获取时区管理列表响应
	ListTimezonesResponse {
		// 数据总数
		Total int64 `json:"total"`
		// 时区列表
		List []TimezoneInfo `json:"list"`
	}
	// 获取全部时区请求
	ListAllTimezonesRequest {
		// 状态: 1启用, 2停用
		Status *int64 `form:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 获取全部时区响应
	ListAllTimezonesResponse {
		// 时区列表
		List []TimezoneInfo `json:"list"`
	}
	// 调整时区排序请求
	ReorderTimezoneRequest {
		// 需要移动的时区ID
		Id int64 `json:"id" validate:"required,gt=0"`
		// 目标时区ID
		TargetId int64 `json:"target_id" validate:"required,gt=0"`
	}
	// 调整时区排序响应
	ReorderTimezoneResponse  {}
)

@server (
	group:  timezone
	prefix: /timezone
)
service platform_base {
	// 创建时区
	@handler CreateTimezone
	post /create (CreateTimezoneRequest) returns (CreateTimezoneResponse)

	// 修改时区
	@handler UpdateTimezone
	post /update (UpdateTimezoneRequest) returns (UpdateTimezoneResponse)

	// 获取时区
	@handler GetTimezone
	get /get (GetTimezoneRequest) returns (GetTimezoneResponse)

	// 获取时区管理列表
	@handler ListTimezones
	get /list (ListTimezonesRequest) returns (ListTimezonesResponse)

	// 获取全部时区
	@handler ListAllTimezones
	get /list-all (ListAllTimezonesRequest) returns (ListAllTimezonesResponse)

	// 调整时区排序
	@handler ReorderTimezone
	post /reorder (ReorderTimezoneRequest) returns (ReorderTimezoneResponse)
}

