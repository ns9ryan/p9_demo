syntax = "v1"

import "types/common.api"

type (
	// 分站信息
	OperatorInfo {
		// 分站ID
		Id int64 `json:"id"`
		// 分站业务编码
		Code string `json:"code"`
		// 分站名称
		Name string `json:"name"`
		// 时区编码
		TimezoneCode string `json:"timezone_code"`
		// 结算币种编码
		SettlementCurrencyCode string `json:"settlement_currency_code"`
		// 创建状态: 1草稿, 2已完成
		CreationStatus int64 `json:"creation_status"`
		// 发布状态: 1未发布, 2发布中, 3已发布, 4发布失败
		PublishStatus int64 `json:"publish_status"`
		// 分站状态: 1正常, 2暂停, 3关闭
		Status int64 `json:"status"`
		// 内部备注
		Remark *string `json:"remark,optional"`
		// 首次发布成功时间, Unix毫秒时间戳
		PublishedAt *int64 `json:"published_at,optional"`
		// 创建时间, Unix毫秒时间戳
		CreatedAt int64 `json:"created_at"`
		// 更新时间, Unix毫秒时间戳
		UpdatedAt int64 `json:"updated_at"`
	}
	// 创建分站请求
	CreateOperatorRequest {
		// 分站名称
		Name string `json:"name" validate:"required,max=100"`
		// 时区编码
		TimezoneCode string `json:"timezone_code" validate:"required,max=64"`
		// 结算币种编码
		SettlementCurrencyCode string `json:"settlement_currency_code" validate:"required,max=16"`
		// 分站状态: 1正常, 2暂停, 3关闭
		Status *int64 `json:"status,optional" validate:"omitempty,oneof=1 2 3"`
		// 内部备注
		Remark *string `json:"remark,optional" validate:"omitempty,max=1000"`
	}
	// 创建分站响应
	CreateOperatorResponse {
		// 分站ID
		Id int64 `json:"id"`
		// 分站业务编码
		Code string `json:"code"`
	}
	// 修改分站请求
	UpdateOperatorRequest {
		// 分站ID
		Id int64 `json:"id" validate:"required,gt=0"`
		// 分站名称
		Name *string `json:"name,optional" validate:"omitempty,max=100"`
		// 时区编码
		TimezoneCode *string `json:"timezone_code,optional" validate:"omitempty,max=64"`
		// 结算币种编码
		SettlementCurrencyCode *string `json:"settlement_currency_code,optional" validate:"omitempty,max=16"`
		// 分站状态: 1正常, 2暂停, 3关闭
		Status *int64 `json:"status,optional" validate:"omitempty,oneof=1 2 3"`
		// 内部备注
		Remark *string `json:"remark,optional" validate:"omitempty,max=1000"`
	}
	// 修改分站响应
	UpdateOperatorResponse  {}
	// 获取分站请求
	GetOperatorRequest {
		// 分站ID
		Id int64 `form:"id" validate:"required,gt=0"`
	}
	// 获取分站响应
	GetOperatorResponse {
		// 分站信息
		OperatorInfo
	}
	// 获取分站管理列表请求
	ListOperatorsRequest {
		// 分页参数
		PageRequest
		// 搜索关键字, 匹配分站编码或名称
		Keyword *string `form:"keyword,optional" validate:"omitempty,max=100"`
		// 创建状态: 1草稿, 2已完成
		CreationStatus *int64 `form:"creation_status,optional" validate:"omitempty,oneof=1 2"`
		// 发布状态: 1未发布, 2发布中, 3已发布, 4发布失败
		PublishStatus *int64 `form:"publish_status,optional" validate:"omitempty,oneof=1 2 3 4"`
		// 分站状态: 1正常, 2暂停, 3关闭
		Status *int64 `form:"status,optional" validate:"omitempty,oneof=1 2 3"`
	}
	// 获取分站管理列表响应
	ListOperatorsResponse {
		// 数据总数
		Total int64 `json:"total"`
		// 分站列表
		List []OperatorInfo `json:"list"`
	}
	// 完成分站创建请求
	CompleteOperatorRequest {
		// 分站ID
		Id int64 `json:"id" validate:"required,gt=0"`
	}
	// 完成分站创建响应
	CompleteOperatorResponse  {}
	// 发布分站请求
	PublishOperatorRequest {
		// 分站ID
		Id int64 `json:"id" validate:"required,gt=0"`
	}
	// 发布分站响应
	PublishOperatorResponse  {}
)

@server (
	group:      operator
	prefix:     /admin/operator
	middleware: Jwt,ActionLog,Authority
)
service platform_operator {
	// 创建分站
	@handler CreateOperator
	post /create (CreateOperatorRequest) returns (CreateOperatorResponse)

	// 修改分站
	@handler UpdateOperator
	post /update (UpdateOperatorRequest) returns (UpdateOperatorResponse)

	// 获取分站
	@handler GetOperator
	get /get (GetOperatorRequest) returns (GetOperatorResponse)

	// 获取分站管理列表
	@handler ListOperators
	get /list (ListOperatorsRequest) returns (ListOperatorsResponse)

	// 完成分站创建
	@handler CompleteOperator
	post /complete (CompleteOperatorRequest) returns (CompleteOperatorResponse)

	// 发布分站
	@handler PublishOperator
	post /publish (PublishOperatorRequest) returns (PublishOperatorResponse)
}

