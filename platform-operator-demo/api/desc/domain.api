syntax = "v1"

import "types/common.api"

type (
	// 分站域名信息
	DomainInfo {
		// 域名ID
		Id int64 `json:"id"`
		// 分站ID
		OperatorId int64 `json:"operator_id"`
		// 域名, 不包含协议和端口
		DomainName string `json:"domain_name"`
		// 域名类型: 1分站后台, 2代理后台, 3会员H5
		DomainType int64 `json:"domain_type"`
		// 域名状态: 1启用, 2停用
		Status int64 `json:"status"`
		// 总网内部备注
		Remark *string `json:"remark,optional"`
		// 创建时间, Unix毫秒时间戳
		CreatedAt int64 `json:"created_at"`
		// 更新时间, Unix毫秒时间戳
		UpdatedAt int64 `json:"updated_at"`
	}
	// 创建分站域名请求
	CreateDomainRequest {
		// 分站ID
		OperatorId int64 `json:"operator_id" validate:"required,gt=0"`
		// 域名, 不包含协议和端口
		DomainName string `json:"domain_name" validate:"required,max=253"`
		// 域名类型: 1分站后台, 2代理后台, 3会员H5
		DomainType int64 `json:"domain_type" validate:"required,oneof=1 2 3"`
		// 域名状态: 1启用, 2停用
		Status *int64 `json:"status,optional" validate:"omitempty,oneof=1 2"`
		// 总网内部备注
		Remark *string `json:"remark,optional" validate:"omitempty,max=1000"`
	}
	// 创建分站域名响应
	CreateDomainResponse {
		// 域名ID
		Id int64 `json:"id"`
	}
	// 修改分站域名请求
	UpdateDomainRequest {
		// 域名ID
		Id int64 `json:"id" validate:"required,gt=0"`
		// 域名
		DomainName *string `json:"domain_name,optional" validate:"omitempty,max=253"`
		// 域名类型: 1分站后台, 2代理后台, 3会员H5
		DomainType *int64 `json:"domain_type,optional" validate:"omitempty,oneof=1 2 3"`
		// 域名状态: 1启用, 2停用
		Status *int64 `json:"status,optional" validate:"omitempty,oneof=1 2"`
		// 总网内部备注
		Remark *string `json:"remark,optional" validate:"omitempty,max=1000"`
	}
	// 修改分站域名响应
	UpdateDomainResponse  {}
	// 获取分站域名请求
	GetDomainRequest {
		// 域名ID
		Id int64 `form:"id" validate:"required,gt=0"`
	}
	// 获取分站域名响应
	GetDomainResponse {
		DomainInfo
	}
	// 获取分站域名列表请求
	ListDomainsRequest {
		// 分页参数
		PageRequest
		// 分站ID
		OperatorId *int64 `form:"operator_id,optional" validate:"omitempty,gt=0"`
		// 搜索关键字, 匹配域名
		Keyword *string `form:"keyword,optional" validate:"omitempty,max=253"`
		// 域名类型: 1分站后台, 2代理后台, 3会员H5
		DomainType *int64 `form:"domain_type,optional" validate:"omitempty,oneof=1 2 3"`
		// 域名状态: 1启用, 2停用
		Status *int64 `form:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	// 获取分站域名列表响应
	ListDomainsResponse {
		// 数据总数
		Total int64 `json:"total"`
		// 域名列表
		List []DomainInfo `json:"list"`
	}
	// 删除分站域名请求
	DeleteDomainRequest {
		// 域名ID
		Id int64 `json:"id" validate:"required,gt=0"`
	}
	// 删除分站域名响应
	DeleteDomainResponse  {}
)

@server (
	group:      domain
	prefix:     /admin/operator/domain
	middleware: Jwt,ActionLog,Authority
)
service platform_operator {
	// 创建分站域名
	@handler CreateDomain
	post /create (CreateDomainRequest) returns (CreateDomainResponse)

	// 修改分站域名
	@handler UpdateDomain
	post /update (UpdateDomainRequest) returns (UpdateDomainResponse)

	// 获取分站域名
	@handler GetDomain
	get /get (GetDomainRequest) returns (GetDomainResponse)

	// 获取分站域名列表
	@handler ListDomains
	get /list (ListDomainsRequest) returns (ListDomainsResponse)

	// 删除分站域名
	@handler DeleteDomain
	post /delete (DeleteDomainRequest) returns (DeleteDomainResponse)
}

