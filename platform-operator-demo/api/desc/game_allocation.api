// ==================== 游戏 ====================
@server (
	group:      operator_game
	prefix:     /admin/operator/game
	middleware: Jwt,ActionLog,Authority
)
service platform_operator {
	// 获取分站游戏列表
	@doc "获取分站游戏列表"
	@handler GetOperatorGameList
	get /list (GetOperatorGameListRequest) returns (GetOperatorGameListResponse)

	// 批量创建分站游戏
	@doc "批量创建分站游戏"
	@handler BatchCreateOperatorGame
	post /batch-create (BatchCreateOperatorGameRequest) returns (BatchCreateOperatorGameResponse)

	// 批量修改分站游戏状态
	@doc "批量修改分站游戏状态"
	@handler BatchUpdateOperatorGameStatus
	post /batch-update-status (BatchUpdateOperatorGameStatusRequest) returns (BatchUpdateOperatorGameStatusResponse)

	// 批量删除分站游戏
	@doc "批量删除分站游戏"
	@handler BatchDeleteOperatorGame
	post /batch-delete (BatchDeleteOperatorGameRequest) returns (BatchDeleteOperatorGameResponse)
}

