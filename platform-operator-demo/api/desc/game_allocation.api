	// 批量创建分站游戏渠道
	@doc "批量创建分站游戏渠道"
	@handler BatchCreateOperatorGameChannel
	post /batch-create (BatchCreateOperatorGameChannelRequest) returns (BatchCreateOperatorGameChannelResponse)

	// 批量修改分站游戏渠道状态
	@doc "批量修改分站游戏渠道状态"
	@handler BatchUpdateOperatorGameChannelStatus
	post /batch-update-status (BatchUpdateOperatorGameChannelStatusRequest) returns (BatchUpdateOperatorGameChannelStatusResponse)

	// 批量删除分站游戏渠道
	@doc "批量删除分站游戏渠道"
	@handler BatchDeleteOperatorGameChannel
	post /batch-delete (BatchDeleteOperatorGameChannelRequest) returns (BatchDeleteOperatorGameChannelResponse)
}

// ==================== 游戏提供商 ====================
@server (
	group:      operator_game_provider
	prefix:     /admin/operator/game-provider
	middleware: Jwt,ActionLog,Authority
)
service platform_operator {
	// 获取分站游戏提供商列表
	@doc "获取分站游戏提供商列表"
	@handler GetOperatorGameProviderList
	get /list (GetOperatorGameProviderListRequest) returns (GetOperatorGameProviderListResponse)

	// 批量创建分站游戏提供商
	@doc "批量创建分站游戏提供商"
	@handler BatchCreateOperatorGameProvider
	post /batch-create (BatchCreateOperatorGameProviderRequest) returns (BatchCreateOperatorGameProviderResponse)

	// 批量修改分站游戏提供商状态
	@doc "批量修改分站游戏提供商状态"
	@handler BatchUpdateOperatorGameProviderStatus
	post /batch-update-status (BatchUpdateOperatorGameProviderStatusRequest) returns (BatchUpdateOperatorGameProviderStatusResponse)

	// 批量删除分站游戏提供商
	@doc "批量删除分站游戏提供商"
	@handler BatchDeleteOperatorGameProvider
	post /batch-delete (BatchDeleteOperatorGameProviderRequest) returns (BatchDeleteOperatorGameProviderResponse)
